{
  "schema_version": "ooptdd-functional-solid-contract/v1",
  "harness_tier": "L_IDE",
  "source_root": "src",
  "package": "ooptdd",
  "claim": "OOPTDD explicitly classifies every shipped module and keeps its generic functional core independent from adapters and opt-in domain extensions. FA003 and FA004 are module-local syntactic checks, not transitive purity proofs; the contract does not prove semantic purity or SOLID.",
  "purity_scope": "direct-module-syntax-only",
  "fail_on_unclassified_modules": true,
  "layers": [
    {
      "name": "pure_core",
      "exact_modules": [
        "ooptdd.engine.gate_freeze",
        "ooptdd.engine.gate_kernel",
        "ooptdd.engine.gate_ontology",
        "ooptdd.engine.gate_primitives",
        "ooptdd.engine.gate_rules",
        "ooptdd.engine.gate_values",
        "ooptdd.ouroboros.conformance",
        "ooptdd.ouroboros.identity",
        "ooptdd.ouroboros.model",
        "ooptdd.ouroboros.ports",
        "ooptdd.ouroboros.receipt",
        "ooptdd.ouroboros.reducer"
      ],
      "module_prefixes": [],
      "may_depend_on": [
        "domain",
        "pure_core"
      ]
    },
    {
      "name": "domain",
      "exact_modules": [
        "ooptdd.domain",
        "ooptdd.domain.model",
        "ooptdd.domain.ontology",
        "ooptdd.domain.ports",
        "ooptdd.domain.settings"
      ],
      "module_prefixes": [],
      "may_depend_on": [
        "domain"
      ]
    },
    {
      "name": "engine",
      "exact_modules": [
        "ooptdd.engine",
        "ooptdd.engine.gate",
        "ooptdd.engine.monitor",
        "ooptdd.engine.polling",
        "ooptdd.engine.verify"
      ],
      "module_prefixes": [],
      "may_depend_on": [
        "domain",
        "engine",
        "pure_core"
      ]
    },
    {
      "name": "protocol_api",
      "exact_modules": [
        "ooptdd.ouroboros"
      ],
      "module_prefixes": [],
      "may_depend_on": [
        "protocol_api",
        "pure_core"
      ]
    },
    {
      "name": "adapters",
      "exact_modules": [
        "ooptdd.adapters",
        "ooptdd.adapters.negative_assertion",
        "ooptdd.adapters.pytest",
        "ooptdd.adapters.pytest_cli",
        "ooptdd.assertions",
        "ooptdd.backends",
        "ooptdd.backends.base",
        "ooptdd.backends.clickhouse",
        "ooptdd.backends.conformance",
        "ooptdd.backends.jsonl",
        "ooptdd.backends.memory",
        "ooptdd.backends.openobserve",
        "ooptdd.backends.otel",
        "ooptdd.backends.settings",
        "ooptdd.backends.victorialogs",
        "ooptdd.bootstrap",
        "ooptdd.cli",
        "ooptdd.config",
        "ooptdd.gate",
        "ooptdd.model",
        "ooptdd.monitor",
        "ooptdd.ontology",
        "ooptdd.plugin",
        "ooptdd.probes",
        "ooptdd.probes.file",
        "ooptdd.probes.http",
        "ooptdd.reports",
        "ooptdd.verify"
      ],
      "module_prefixes": [],
      "may_depend_on": [
        "adapters",
        "domain",
        "engine",
        "protocol_api",
        "pure_core"
      ],
      "default": true
    },
    {
      "name": "api",
      "exact_modules": [
        "ooptdd",
        "ooptdd.identity",
        "ooptdd.sdk"
      ],
      "module_prefixes": [],
      "may_depend_on": [
        "adapters",
        "api",
        "domain",
        "engine",
        "protocol_api",
        "pure_core"
      ]
    }
  ],
  "pure_modules": [
    "ooptdd.engine.gate_primitives",
    "ooptdd.engine.gate_freeze",
    "ooptdd.engine.gate_values",
    "ooptdd.engine.gate_ontology",
    "ooptdd.engine.gate_rules",
    "ooptdd.engine.gate_kernel",
    "ooptdd.ouroboros.conformance",
    "ooptdd.ouroboros.identity",
    "ooptdd.ouroboros.model",
    "ooptdd.ouroboros.ports",
    "ooptdd.ouroboros.receipt",
    "ooptdd.ouroboros.reducer"
  ],
  "package_root_import_allowlist": [
    "__version__"
  ],
  "configuration_boundary": {
    "environment_key_owner": "ooptdd.domain.settings",
    "environment_key_patterns": [
      "^OOPTDD_[A-Z0-9_]+$",
      "^OTEL_EXPORTER_[A-Z0-9_]+$"
    ],
    "ambient_environment_modules": [
      "ooptdd.bootstrap",
      "ooptdd.config"
    ]
  },
  "edge_vocabulary_boundary": {
    "forbidden_layers": [
      "api",
      "domain",
      "engine",
      "protocol_api",
      "pure_core"
    ],
    "patterns": [
      {
        "id": "test-framework",
        "regex": "(?i)\\bpytest\\b|\\btest_(?:session|outcome)\\b"
      },
      {
        "id": "model-domain",
        "regex": "(?i)\\bgen[_ -]?ai\\b|\\btrajectory\\b",
        "forbidden_layers": [
          "adapters",
          "api",
          "domain",
          "engine",
          "protocol_api",
          "pure_core"
        ]
      },
      {
        "id": "development-method",
        "regex": "(?i)\\btdd\\b|test[-_ ]driven|\\bred[-_ ]green\\b|\\b(?:red|green)_phase\\b",
        "forbidden_layers": [
          "adapters",
          "api",
          "domain",
          "engine",
          "protocol_api",
          "pure_core"
        ]
      },
      {
        "id": "project-history",
        "regex": "(?i)\\bsymposium\\b|\\blakatotree\\b|\\b(?:p333|omd)\\b|\\bhswm\\b|\\bapt[-_ ](?:sa|sp|st|scw)\\b",
        "forbidden_layers": [
          "adapters",
          "api",
          "domain",
          "engine",
          "protocol_api",
          "pure_core"
        ]
      },
      {
        "id": "profile-workflow",
        "regex": "(?i)ooptdd[_ -]?mutation|mutation[_ -]?(?:workflow|profile|testing|gate)",
        "forbidden_layers": [
          "adapters",
          "api",
          "domain",
          "engine",
          "protocol_api",
          "pure_core"
        ]
      },
      {
        "id": "prescribed-methodology",
        "regex": "(?i)METHODOLOGY\\.md|development[-_ ]methodolog",
        "forbidden_layers": [
          "adapters",
          "api",
          "domain",
          "engine",
          "protocol_api",
          "pure_core"
        ]
      },
      {
        "id": "workflow-lineage",
        "regex": "(?i)\\bcycle_id\\b|\\bsuccessor_cycle_id\\b",
        "forbidden_layers": [
          "adapters",
          "api",
          "domain",
          "engine",
          "protocol_api",
          "pure_core"
        ]
      }
    ],
    "scan_comments_and_docstrings": true
  },
  "pure_boundary": {
    "forbidden_import_roots": [
      "asyncio",
      "datetime",
      "logging",
      "multiprocessing",
      "os",
      "pathlib",
      "random",
      "requests",
      "secrets",
      "socket",
      "subprocess",
      "tempfile",
      "threading",
      "time",
      "urllib",
      "uuid"
    ],
    "forbidden_calls": [
      "__import__",
      "breakpoint",
      "compile",
      "eval",
      "exec",
      "input",
      "open",
      "print"
    ],
    "allowed_imports_by_module": {
      "ooptdd.engine.gate_freeze": [
        "datetime.date",
        "pathlib.Path",
        "pathlib.PosixPath",
        "pathlib.PurePath",
        "pathlib.PurePosixPath",
        "pathlib.PureWindowsPath",
        "pathlib.WindowsPath",
        "uuid.UUID"
      ]
    },
    "require_frozen_dataclasses": true,
    "forbid_global_nonlocal": true,
    "forbid_module_global_mutation": true
  },
  "responsibility_budgets": [
