{
  "schema_version": "fsm-spec/v1",
  "name": "ooptdd-ouroboros-generation",
  "scope": "Normative normal-flow and mutation-safety projection. Reducer guards and tests are authoritative for replay, terminal, recovery exclusivity, identity-conflict, budget-exhaustion, and inconclusive fault overlays that are deliberately not expanded into this compact machine.",
  "execution": {
    "step_interface": "step(CycleSnapshot, ProtocolEvent) -> TransitionResult",
    "event_queue": "The caller presents one immutable, cycle-scoped event at a time.",
    "run_to_completion": "One event is fully selected and reduced before another event observes the snapshot.",
    "action_order": "Validate full cycle identity; resolve replay, terminal, recovery, collision, and budget guards; then parse the payload, select a phase transition, build the next immutable value, and return stable effect intents.",
    "persistence": "Caller-owned; this projection does not imply a journal, scheduler, or effect executor."
  },
  "context_schema": {
    "remaining_findings": {
      "type": "non-negative integer"
    },
    "bound_material_changed": {
      "type": "boolean"
    },
    "successor_cycle_id": {
      "type": "string"
    },
    "mutation_active": {
